# ── Linux Native (SteamCMD, không Docker) ────────────────────────────────────
#   cp .env.example .env
#   # Sửa ADMIN_PASSWORD (bắt buộc), SERVER_NAME, SERVER_PASSWORD
#   ./native/setup.sh
#   sudo systemctl start conan
#   Firewall: sudo ufw allow 7777:7778/udp && sudo ufw allow 27015/udp
#
# Conan Exiles Enhanced (UE5) — binary Linux native, AppID 443030.
# RAM idle ~9 GB → VPS cần tối thiểu 10–12 GB (khuyến nghị 16 GB).

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_NAME="My Conan Server"
# Để trống = server mở (không mật khẩu join)
SERVER_PASSWORD=
# Mật khẩu MakeMeAdmin trong game (bắt buộc đổi)
ADMIN_PASSWORD=changeme-admin

SERVER_PORT=7777
QUERY_PORT=27015
MAX_PLAYERS=10
MULTIHOME=0.0.0.0

# PvP: false = PvE
PVP_ENABLED=false
# 0=none, 1=partial, 2=full
MAX_NUDITY=1
BATTLEYE=False

# Thêm arg launch (cách nhau bởi khoảng trắng)
# SERVER_ARGS=

# ── RCON ─────────────────────────────────────────────────────────────────────
RCON_ENABLED=false
RCON_PASSWORD=
RCON_PORT=25575
RCON_MAX_CLIENTS=5

# ── Backup / update ──────────────────────────────────────────────────────────
TZ=Asia/Ho_Chi_Minh
BACKUPS=true
BACKUPS_CRON="0 */6 * * *"
BACKUPS_MAX_AGE=3
BACKUPS_MAX_COUNT=5

# Tắt server rồi update (cron). Để trống = không cài cron update.
# UPDATE_CRON="0 5 * * 0"

# ── Systemd (tùy chọn) ───────────────────────────────────────────────────────
# CONAN_SERVICE_NAME=conan
