# ── Linux (Docker) ─────────────────────────────────────────────────────────────
#   cp .env.example .env
#   ./linux/setup.sh
#
# ── Linux (Native — SteamCMD, không Docker, không playit) ─────────────────────
#   cp .env.example .env
#   ./native/setup.sh
#   sudo systemctl start valheim
#   Mở firewall VPS: sudo ufw allow 2456:2457/udp
#
# ── Windows (Docker Desktop) ──────────────────────────────────────────────────
#   copy .env.example .env
#   windows\setup.bat
#   (hoặc: powershell -ExecutionPolicy Bypass -File windows\setup.ps1)
#
# Lần đầu chạy tải game server (~1 GB), đợi vài phút.
# Sau khi server chạy lần đầu, chỉnh ServerCharacters tại:
#   config/bepinex/config/<file ServerCharacters>.cfg
# Bật Single Character Mode, tắt Backup Only Mode.

# ── Playit (port forward, không cần mở router) ──────────────────────────────
# Wizard: https://playit.gg/account/agents → Docker Compose → copy SECRET_KEY
PLAYIT_SECRET_KEY=
# PLAYIT_VERSION=0.17
#
# Tạo tunnel Valheim trên dashboard:
#   Local Address = 127.0.0.1
#   Port = 2456 và 2457 (UDP)
# (playit dùng network_mode: host, valheim publish port ra localhost)

# ── Valheim Server ───────────────────────────────────────────────────────────
# UID/GID user chạy container — linux/setup.sh tự điền (tránh file root-owned)
PUID=1000
PGID=1000

SERVER_NAME="My Valheim Server"
WORLD_NAME=L6tivqKbxq
# Seed nằm trong file config/worlds_local/<WORLD_NAME>.fwl (không có flag -seed).
# World mới: tạo .fwl bằng MakeFwl (CrystalFerrai/MakeFwl) rồi copy vào worlds_local/.
# ≥5 ký tự, không được là substring của SERVER_NAME. Public server nên dùng pass mạnh.
SERVER_PASS="change-me-strong-pass"
# true = hiện browser Steam + cho trang status check được; false = chỉ Join IP
SERVER_PUBLIC=true

# World modifiers (giống sửa start_server.bat trên Windows)
# https://valheim.com/support/a-guide-to-dedicated-servers/
# combat
# veryeasy, easy, hard, veryhard
# resources
# muchless, less, more, muchmore, most
# portals
# casual, hard, veryhard
# deathpenalty
# casual, veryeasy, easy, hard, hardcore
# raids
# none, muchless, less, more, muchmore
# SERVER_ARGS="-modifier combat hard -modifier resources most -modifier portals casual"
# Preset (đặt trước modifier, sẽ ghi đè modifier cùng loại): SERVER_ARGS="-preset casual"
# Áp dụng khi TẠO world — world "Dedicated" đã có thì đổi WORLD_NAME hoặc xóa config/worlds_local/

# SteamID64 của admin (cách nhau bởi dấu cách). Để trống khi chơi bình thường.
# Admin: lệnh ServerCharacters (giveitem, ...) + vanilla devcommands nếu cài Server devcommands.
# ADMINLIST_IDS=

# Múi giờ (ảnh hưởng log & lịch backup/update)
TZ=Asia/Ho_Chi_Minh

# Backup world tự động
BACKUPS=true
BACKUPS_CRON="0 */6 * * *"
BACKUPS_MAX_AGE=3
BACKUPS_MAX_COUNT=5

# Tự cập nhật game khi không có người chơi
UPDATE_CRON="*/15 * * * *"

# ── Mods (ServerCharacters) ──────────────────────────────────────────────────
# Bật BepInEx — image tự cài BepInExPack; mod đặt tại config/bepinex/plugins/
BEPINEX=true

# Mod downloads dùng Hexium (https://valheim.hexium.gg) — không còn Thunderstore.
# Phiên bản ServerCharacters (linux/windows/native install script)
# SERVERCHARACTERS_VERSION=1.4.17

# Phiên bản Server devcommands — tùy chọn, chỉ admin (./native/install-serverdevcommands.sh)
# SERVER_DEVCOMMANDS_VERSION=1.113.0

# Phiên bản BepInExPack (native/setup.sh)
# BEPINEX_PACK_VERSION=5.4.2351

# Modpack client+server (./native/install-mymodpack.sh) — ưu tiên hơn cài từng QoL mod
# MYMODPACK_VERSION=1.0.1

# Phiên bản AzuCraftyBoxes lẻ (./native/install-azucraftyboxes.sh) — chỉ khi không dùng modpack
# AZUCRAFTYBOXES_VERSION=1.8.24

# Phiên bản TargetPortal / Azumatt extras (Gale/Hexium sync)
# TARGETPORTAL_VERSION=1.2.7
# AZUEXTENDEDPLAYERINVENTORY_VERSION=2.5.1
# AZUAUTOSTORE_VERSION=3.1.6
# AAA_CRAFTING_VERSION=2.1.10

# Crossplay / PlayFab — BẬT MẶC ĐỊNH (bắt buộc với Valheim 1.0 dedicated).
# Join IP (Gale/Steam) thường search PlayFab với crossplay=True.
# Nếu CROSSPLAY=false, client báo zero lobbies / không vào được dù Steam thấy server.
# Cần lib Linux: libatomic1, libpulse0, libpulse-mainloop-glib0 (./native/install-deps.sh).
# Live VPS: ServerCharacters tạm tắt — DLL ở config/bepinex/plugins_disabled/
# (không tương thích PlayFab). Bật lại khi tắt crossplay.
# Docker/playit: thêm tunnel UDP port 2458.
# Join: IP:2456 / Join Code (vd 314166) trong log hoặc public/index.html.
CROSSPLAY=true
